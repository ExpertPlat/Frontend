# API services in this project already prefix endpoints with /api.
# Keep this value at the origin level to avoid /api/api/... URLs.
# Local backend:   VITE_API_BASE_URL=http://localhost:8000
# Laravel Cloud:   VITE_API_BASE_URL=https://<your-backend-domain>
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPPORT_EMAIL=support@solveit.com

# Every call in the User (/app/*), Expert (/expert/*) and Admin (/admin/*) workspaces goes to the Laravel backend above.
# There is no mock server or demo mode any more.

# ── Trial / investor demo ────────────────────────────────────────────────
# true  → login pages get a "Fill a demo account" button + walkthrough, journey pages show "where to go next" cards,
#         experts show a "Demo" badge and a floating "Switch account" pill appears.
# false/unset → none of that is rendered (use this for the real launch).
VITE_DEMO_MODE=true
